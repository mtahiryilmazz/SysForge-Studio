<Window x:Class="UltimateToolkit.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UltimateToolkit.Modern"
        mc:Ignorable="d"
        Title="Ultimate Toolkit - Enterprise Unified Suite" 
        Height="800" Width="1240"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PtWindowBg}"
        FontFamily="{StaticResource PtFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left PowerToys Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PtSidebarBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand & Search Bar -->
                <StackPanel Grid.Row="0" Margin="16,18,16,12">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PtAccentGradient}" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="🛠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ultimate Toolkit" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}" />
                            <TextBlock Text="Enterprise Unified Suite" FontSize="11" Foreground="{StaticResource PtTextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Quick Search Box (overlay placeholder — VisualBrush cue breaks dark background) -->
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="TxtSearch" Height="34" VerticalContentAlignment="Center"
                                 Style="{StaticResource PtTextBox}" TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Text="🔍 Modüllerde ara..."
                                   Foreground="#777777" FontSize="12" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Separator Background="{StaticResource PtCardBorder}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- PowerToys Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,0">
                        <TextBlock Text="GENEL BAKIŞ" FontSize="10.5" FontWeight="Bold" Foreground="#666666" Margin="18,10,16,4"/>
                        <RadioButton x:Name="NavDashboard" Content="📊  Genel Bakış &amp; Durum" Style="{StaticResource PtNavButtonStyle}" IsChecked="True" Checked="Nav_Checked"/>

                        <TextBlock Text="YAZICI &amp; AĞ YÖNETİMİ" FontSize="10.5" FontWeight="Bold" Foreground="#666666" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavPrinters" Content="🖨️  Yazıcı Bağla &amp; Keşif" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Content="🌐  IP Tarama &amp; Uzak Masaüstü" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDrivers" Content="🧹  Sürücü Temizliği" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="ONARIM &amp; TWEAKS" FontSize="10.5" FontWeight="Bold" Foreground="#666666" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavFixes" Content="⚡  Yazıcı Hızlı Onarım" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSysRepair" Content="🔧  Windows Çekirdek Onarım" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDiag" Content="🔍  Sistem Teşhisi" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Content="🛠️  Sistem Araçları" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="GELİŞMİŞ MOTORLAR &amp; V5 / V6" FontSize="10.5" FontWeight="Bold" Foreground="#666666" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavModules" Content="🚀  Entegre Motorlar (v6 / v5)" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="DONANIM &amp; BT TEKNİK SERVİS" FontSize="10.5" FontWeight="Bold" Foreground="#666666" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavExpertise" Content="🛡️  Donanım Ekspertizi &amp; Hash" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavITService" Content="💼  BT Servis Portali &amp; Vanguard" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="GÜNLÜK &amp; YEDEKLEME" FontSize="10.5" FontWeight="Bold" Foreground="#666666" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavLogs" Content="📋  Canlı Çıktı &amp; Terminal" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavBackup" Content="💾  Yedekleme Havuzu" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="0,1,0,0" Background="#161616">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PowerToys Style v6.0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PtTextSecondary}"/>
                            <TextBlock Text="Windows 11 / 10 / Server" FontSize="10" Foreground="#606060"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PtBadge}">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PtAccent}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Main Workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Breadcrumb -->
            <Border Grid.Row="0" Background="{StaticResource PtWindowBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="0,0,0,1" Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="Genel Bakış &amp; Durum" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Sistem yazdırma durumu ve hızlı eylemler" FontSize="12" Foreground="{StaticResource PtTextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Top Right Badges & Progress -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="PbBusy" Width="100" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0" Foreground="{StaticResource PtAccent}"/>
                        <Border Style="{StaticResource PtBadge}" Padding="10,5">
                            <TextBlock Text="🛡️ Yönetici Modu" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Content -->
            <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
