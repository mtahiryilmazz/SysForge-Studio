<UserControl x:Class="UltimateToolkit.Modern.Views.ITTechServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:UltimateToolkit.Modern.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="💼 BT Teknik Servis Masası &amp; Zimmet Portali" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}" />
                    <TextBlock Text="Arıza bildirimleri, kullanıcı destek talepleri ve donanım zimmet envanteri (Saf yerel C# &amp; SQLite altyapısı)." 
                               FontSize="13" Foreground="{StaticResource PtTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Verileri Yenile" Style="{StaticResource PtSecondaryButton}" Click="BtnRefresh_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 1. KPI Metric Summary Cards (DevToys Style) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PtCardBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="AÇIK ARIZA TALEPLERİ" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="TxtOpenTicketsCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PtCardBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ÇÖZÜLEN ÇAĞRILAR" FontSize="11" FontWeight="Bold" Foreground="#107C41"/>
                        <TextBlock x:Name="TxtResolvedTicketsCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource PtCardBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="KAYITLI DONANIM ENVANTERİ" FontSize="11" FontWeight="Bold" Foreground="#0078D4"/>
                        <TextBlock x:Name="TxtInventoryCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Tickets Section (Arıza & Destek Talepleri) -->
            <Border Background="{StaticResource PtCardBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="🎫 Arıza &amp; Destek Talepleri (Tickets)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}"/>
                        <TextBlock Text="Yeni talep oluşturun veya durumunu güncelleyin" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource PtTextSecondary}"/>
                    </Grid>

                    <!-- New Ticket Form -->
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtNewPerson" Grid.Row="0" Grid.Column="0" Height="34" Style="{StaticResource PtTextBox}" Margin="0,0,0,6"/>
                            <TextBlock Text="Personel Adı" Grid.Row="0" Grid.Column="0" Foreground="#666666" Margin="8,8,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TxtNewPerson, Converter={x:Static local:EmptyToVisibilityConverter.Instance}}"/>

                            <TextBox x:Name="TxtNewDept" Grid.Row="0" Grid.Column="2" Height="34" Style="{StaticResource PtTextBox}" Margin="0,0,0,6"/>
                            <TextBlock Text="Birim / Müdürlük" Grid.Row="0" Grid.Column="2" Foreground="#666666" Margin="8,8,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TxtNewDept, Converter={x:Static local:EmptyToVisibilityConverter.Instance}}"/>

                            <TextBox x:Name="TxtNewInternal" Grid.Row="0" Grid.Column="4" Height="34" Style="{StaticResource PtTextBox}" Margin="0,0,0,6"/>
                            <TextBlock Text="Dahili No" Grid.Row="0" Grid.Column="4" Foreground="#666666" Margin="8,8,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TxtNewInternal, Converter={x:Static local:EmptyToVisibilityConverter.Instance}}"/>

                            <ComboBox x:Name="CmbNewIssueType" Grid.Row="0" Grid.Column="6" Height="34" Style="{StaticResource PtComboBox}" Margin="0,0,0,6">
                                <ComboBoxItem Content="Yazıcı Sorunu" IsSelected="True"/>
                                <ComboBoxItem Content="Ağ / İnternet"/>
                                <ComboBoxItem Content="Donanım Arızası"/>
                                <ComboBoxItem Content="Yazılım / İşletim Sistemi"/>
                                <ComboBoxItem Content="E-Posta / Hesap"/>
                            </ComboBox>

                            <!-- Row 2: Description and Submit -->
                            <TextBox x:Name="TxtNewDesc" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Height="34" Style="{StaticResource PtTextBox}"/>
                            <TextBlock Text="Arıza / Talep açıklaması..." Grid.Row="1" Grid.Column="0" Foreground="#666666" Margin="8,8,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TxtNewDesc, Converter={x:Static local:EmptyToVisibilityConverter.Instance}}"/>

                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="8" Content="➕ Talep Ekle" Style="{StaticResource PtPrimaryButton}" Width="110" Click="BtnAddTicket_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tickets List -->
                    <ItemsControl x:Name="ListTickets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1C1C" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PersonnelName}" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Department}" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IssueType}" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Description}" Foreground="#888888" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <Border Grid.Column="5" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#332200"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Çözüldü">
                                                            <Setter Property="Background" Value="#103318"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Çözüldü">
                                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✓ Çözüldü" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="BtnResolveTicket_Click"/>
                                            <Button Content="🗑️" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="8,3" FontSize="11" Click="BtnDeleteTicket_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Hardware Inventory Section (Donanım Zimmet Envanteri) -->
            <Border Background="{StaticResource PtCardBg}" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="🖥️ Cihaz &amp; Donanım Zimmet Envanteri" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}"/>
                        <Button Content="⚡ Bu Bilgisayarı Envantere Otomatik Ekle" Style="{StaticResource PtPrimaryButton}" HorizontalAlignment="Right" Click="BtnAutoRegisterPc_Click"/>
                    </Grid>

                    <!-- Inventory List -->
                    <ItemsControl x:Name="ListInventory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1C1C" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Brand}" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Model}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SerialNo, StringFormat='SN: {0}'}" FontFamily="Consolas" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontFamily="Consolas" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding UserName, StringFormat='Kullanıcı: {0}'}" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="5" Content="🗑️" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="8,3" FontSize="11" Click="BtnDeleteInventory_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>