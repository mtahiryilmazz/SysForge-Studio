<UserControl x:Class="UltimateToolkit.Modern.Views.ConnectPrinterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Connect Box (PowerToys Style) -->
        <Border Grid.Row="0" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔗 Ağ veya Yerel Yazıcı Bağla" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Paylaşılan yazıcının UNC yolunu veya sunucu IP adresini girin (Örn: \\192.168.1.100\HP_LaserJet veya \\MUHASEBE\Canon)" FontSize="12" Foreground="{StaticResource PtTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtPrinterUnc" Grid.Row="0" Style="{StaticResource PtTextBox}" Height="38" Text="\\192.168.1.100\PrinterShare" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                        <Button x:Name="BtnTestConnection" Content="🔍 Ön Bağlantı Testi" Style="{StaticResource PtSecondaryButton}" Height="36" Margin="0,0,8,0" Click="BtnTestConnection_Click"/>
                        <Button x:Name="BtnConnectPrinter" Content="🚀 Yazıcıyı Bağla" Style="{StaticResource PtPrimaryButton}" Height="36" Click="BtnConnectPrinter_Click"/>
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Printer List Grid -->
        <Border Grid.Row="1" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖨️ Yüklü Yazıcılar" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtListCount" Text="(0 yazıcı)" FontSize="13" Foreground="{StaticResource PtTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="🔄 Listeyi Yenile" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                        <Button Content="🌐 Ağ Paylaşımlarını Tara" Style="{StaticResource PtPrimaryButton}" Click="BtnScanNetwork_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="DgPrinters" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="#262626" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1"
                          Foreground="{StaticResource PtTextPrimary}" RowBackground="#2B2B2B" AlternatingRowBackground="#303030"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource PtCardBorder}"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#333333"/>
                            <Setter Property="Foreground" Value="{StaticResource PtTextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource PtCardBorder}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Yazıcı Adı" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Paylaşım Adı" Binding="{Binding ShareName}" Width="*" />
                        <DataGridTextColumn Header="Bağlantı Noktası" Binding="{Binding PortName}" Width="*" />
                        <DataGridTextColumn Header="Sürücü" Binding="{Binding DriverName}" Width="1.5*" />
                        <DataGridCheckBoxColumn Header="Varsayılan" Binding="{Binding IsDefault}" Width="Auto" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Bottom Action Bar for Selected Printer -->
        <Border Grid.Row="2" Style="{StaticResource PtSettingsCard}" Margin="0" Padding="12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="BtnSetDefault" Content="⭐ Varsayılan Yap" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,0" Click="BtnSetDefault_Click"/>
                <Button x:Name="BtnPrintTest" Content="📄 Sınama Sayfası Yazdır" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,0" Click="BtnPrintTest_Click"/>
                <Button x:Name="BtnOpenQueue" Content="📋 Kuyruğu Aç" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,0" Click="BtnOpenQueue_Click"/>
                <Button x:Name="BtnOpenProps" Content="⚙️ Özellikler" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,0" Click="BtnOpenProps_Click"/>
                <Button x:Name="BtnRemovePrinter" Content="🗑️ Yazıcıyı Kaldır" Style="{StaticResource PtDangerButton}" Click="BtnRemovePrinter_Click"/>
            </WrapPanel>
        </Border>
    </Grid>

</UserControl>
