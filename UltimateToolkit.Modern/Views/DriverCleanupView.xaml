<UserControl x:Class="UltimateToolkit.Modern.Views.DriverCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Chips (PowerToys Style) -->
        <Border Grid.Row="0" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🧹 Sürücü Temizliği &amp; Yönetim Havuzu" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PtTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Kullanılmayan, çakışan veya hatalı yazıcı sürücülerini ve OEM paketlerini güvenle kaldırın." FontSize="12" Foreground="{StaticResource PtTextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Sürücüleri Yenile" Style="{StaticResource PtSecondaryButton}" Click="BtnRefreshDrivers_Click"/>
                </Grid>

                <!-- Brand Filter Chips -->
                <WrapPanel Margin="0,14,0,0">
                    <TextBlock Text="Marka Filtresi:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PtTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Tümü" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag=""/>
                    <Button Content="HP" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="HP"/>
                    <Button Content="Canon" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="Canon"/>
                    <Button Content="Epson" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="Epson"/>
                    <Button Content="Brother" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="Brother"/>
                    <Button Content="Ricoh" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="Ricoh"/>
                    <Button Content="Xerox" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="Xerox"/>
                    <Button Content="Kyocera" Style="{StaticResource PtSecondaryButton}" Padding="10,4" Margin="0,0,6,6" Click="BtnFilter_Click" Tag="Kyocera"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Driver DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10" Padding="12">
            <DataGrid x:Name="DgDrivers" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#262626" BorderBrush="{StaticResource PtCardBorder}" BorderThickness="1"
                      Foreground="{StaticResource PtTextPrimary}" RowBackground="#2B2B2B" AlternatingRowBackground="#303030"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource PtCardBorder}"
                      HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#333333"/>
                        <Setter Property="Foreground" Value="{StaticResource PtTextSecondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PtCardBorder}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sürücü Adı" Binding="{Binding Name}" Width="2.5*" />
                    <DataGridTextColumn Header="Üretici" Binding="{Binding Manufacturer}" Width="*" />
                    <DataGridTextColumn Header="Mimari" Binding="{Binding Architecture}" Width="Auto" />
                    <DataGridTextColumn Header="Dosya Yolu" Binding="{Binding DriverPath}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Style="{StaticResource PtSettingsCard}" Margin="0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚠️ Not: Yazıcıya bağlı aktif sürücüyü silmeden önce ilgili yazıcıyı kaldırınız." FontSize="12" Foreground="{StaticResource PtTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnCleanStore" Content="🧹 Eski Paketleri Temizle" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,4" Click="BtnCleanStore_Click"/>
                    <Button x:Name="BtnDeleteDriver" Content="🗑️ Seçilen Sürücüyü Kaldır" Style="{StaticResource PtDangerButton}" Margin="0,0,0,4" Click="BtnDeleteDriver_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
