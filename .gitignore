# ===============================================
# SysForge Studio - .gitignore
# ===============================================

# --- Secrets & Sensitive Data ---
.env
.env.*
.github_token
.github_settings.json
*.cer
*.pfx
*.key
*.token
Config/*.key
Config/*.txt
Config/gemini_api.key
Config/ai_key.txt

# --- Build Outputs ---
bin/
obj/
publish_output/
*.user
*.suo

# --- Python Environments & Caches ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.spec

# --- Temporary & Database WAL Files ---
*.db-shm
*.db-wal
app.log
*.log
install_log.txt
sandbox_warnings.log
toolkit_startup_debug.log

# --- Lisans / yedek veritabanlari (hassas) ---
license.json
*.db

# --- Heavy Binaries & Large Archives ---
*.exe
*.dll
*.pkg
*.pyz
Archive/

# --- IDE & OS ---
.vs/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
