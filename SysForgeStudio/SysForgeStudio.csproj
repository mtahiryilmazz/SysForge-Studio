<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SysForgeStudio</AssemblyName>
    <RootNamespace>SysForgeStudio</RootNamespace>
    <ApplicationTitle>SysForge Studio - Enterprise IT &amp; Hardware Suite</ApplicationTitle>
    <Company>SysForge Enterprise IT Suite</Company>
    <Product>SysForge Studio</Product>
    <Version>6.1.0</Version>
    <FileVersion>6.1.0.0</FileVersion>
    <AssemblyVersion>6.1.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.png" />
    <Content Include="Assets\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The v6 bridge and the printer tools are runtime assets, not C# source. -->
  <!-- Keep the existing Modules layout in both build and publish outputs. -->
  <ItemGroup>
    <Content Include="..\Modules\**\*">
      <Link>Modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\dashboard.html">
      <Link>dashboard.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\server.js">
      <Link>server.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Launch-NodeServer.cmd">
      <Link>Launch-NodeServer.cmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8: System.Management ve ServiceProcess dahili, paket gerekmez -->
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="WPF-UI" Version="4.0.2" />
  </ItemGroup>
</Project>
