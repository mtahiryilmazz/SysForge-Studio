<UserControl x:Class="SysForgeStudio.Views.ITTechServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SysForgeStudio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="💼 BT Teknik Servis Masası &amp; Müdürlük Portali" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" />
                    <TextBlock Text="Müdürlük &amp; birim yönetimi, arıza talepleri, zimmet envanteri ve dahili C# web konsolu." 
                               FontSize="13" Foreground="{DynamicResource PtTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Verileri Yenile" Style="{StaticResource PtSecondaryButton}" Click="BtnRefresh_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 1. Embedded Web Dashboard Control Bar -->
            <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🌐 Dahili BT Web Konsolu (Yerel &amp; Ağ Yayını)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}"/>
                        <TextBlock x:Name="TxtWebStatus" Text="⚪ Web sunucusu kapalı. Başlatıldığında ağdaki cihazlar arıza kaydı bırakabilir." FontSize="11" Foreground="{DynamicResource PtTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleWeb" Content="▶️ Web Panelini Başlat" Style="{StaticResource PtPrimaryButton}" Margin="0,0,8,0" Click="BtnToggleWeb_Click"/>
                        <Button x:Name="BtnOpenBrowser" Content="🖥️ Tarayıcıda Aç" Style="{StaticResource PtSecondaryButton}" IsEnabled="False" Click="BtnOpenBrowser_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Integrated enterprise printer repair tools -->
            <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🖨️ PRN Kurumsal Yazıcı Onarım" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}"/>
                            <TextBlock Text="Yazıcı analizi ve onarım araçları BT modülüne entegre edilmiştir; ayrı pencere açılmaz." FontSize="11" Foreground="{DynamicResource PtTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Content="🔄 Yazıcıları Tara" Style="{StaticResource PtSecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRefreshPrinters_Click"/>
                    </Grid>
                    <ComboBox x:Name="CmbEnterprisePrinters" Height="36" Style="{StaticResource PtComboBox}" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="🔎 Tanılama" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnPrinterDiagnosis_Click"/>
                        <Button Content="RPC / 0x11b / 709" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnPrinterRpcFix_Click"/>
                        <Button Content="Point &amp; Print" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnPointPrintFix_Click"/>
                        <Button Content="Spooler Sıfırla" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnSpoolerReset_Click"/>
                        <Button Content="Paylaşım Duvarı" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnPrinterFirewall_Click"/>
                        <Button Content="Sınama Sayfası" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnPrintTestPage_Click"/>
                        <Button Content="Kuyruğu Aç" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,8" Click="BtnOpenPrinterQueue_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtEnterprisePrinterStatus" Text="Yazıcı listesi henüz yüklenmedi." FontSize="11" Foreground="{DynamicResource PtTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. KPI Metric Summary Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="AÇIK ARIZA TALEPLERİ" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="TxtOpenTicketsCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ÇÖZÜLEN ÇAĞRILAR" FontSize="11" FontWeight="Bold" Foreground="#107C41"/>
                        <TextBlock x:Name="TxtResolvedTicketsCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="KAYITLI DONANIM ENVANTERİ" FontSize="11" FontWeight="Bold" Foreground="#0078D4"/>
                        <TextBlock x:Name="TxtInventoryCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Departments & Units Management (Müdürlük & Birim Yönetimi) -->
            <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🏢 Müdürlük &amp; Alt Birim Yönetimi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Add Department -->
                        <TextBox x:Name="TxtNewDeptName" Grid.Column="0" Height="34" Style="{StaticResource PtTextBox}" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Yeni Müdürlük Adı..." Grid.Column="0" Foreground="{DynamicResource PtTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtNewDeptName}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Content="➕ Müdürlük Ekle" Style="{StaticResource PtPrimaryButton}" Height="34" Click="BtnAddDept_Click"/>

                        <!-- Target Department for Unit (Explicit selection) -->
                        <ComboBox x:Name="CmbUnitTargetDept" Grid.Column="4" Height="34" Style="{StaticResource PtComboBox}" DisplayMemberPath="Name"/>

                        <!-- Add Unit -->
                        <TextBox x:Name="TxtNewUnitName" Grid.Column="6" Height="34" Style="{StaticResource PtTextBox}" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Seçili Müdürlüğe Alt Birim..." Grid.Column="6" Foreground="{DynamicResource PtTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtNewUnitName}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="8" Content="➕ Birim Ekle" Style="{StaticResource PtSecondaryButton}" Height="34" Click="BtnAddUnit_Click"/>
                    </Grid>

                    <!-- Departments & Units Detailed List with Delete Support -->
                    <ItemsControl x:Name="ListDepartments">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🏢" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                                                <TextBlock Text="{Binding Units.Count, StringFormat=' ({0} Alt Birim)'}" FontSize="11" Foreground="{DynamicResource PtTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <Button Content="🗑️ Müdürlüğü Sil" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Foreground="#F87171" Click="BtnDeleteDept_Click"/>
                                        </Grid>
                                        
                                        <!-- Units under this department -->
                                        <ItemsControl ItemsSource="{Binding Units}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Margin="20,0,0,0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PtSubtleBg}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PtTextPrimary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <Button Content="✕" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="4,0" FontSize="10" Foreground="#FCA5A5" Click="BtnDeleteUnit_Click" ToolTip="Bu birimi sil"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. Tickets Section (Arıza & Destek Talepleri) -->
            <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🎫 Arıza &amp; Destek Talepleri (Tickets)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}"/>
                        <TextBlock Text="Müdürlük ve personele göre kayıt oluşturun" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource PtTextSecondary}"/>
                    </Grid>

                    <!-- New Ticket Form -->
                    <Border Background="{DynamicResource PtCardBg}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtNewPerson" Grid.Row="0" Grid.Column="0" Height="34" Style="{StaticResource PtTextBox}" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Personel Adı" Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource PtTextSecondary}" Margin="10,0,0,6" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtNewPerson}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ComboBox x:Name="CmbDepts" Grid.Row="0" Grid.Column="2" Height="34" Style="{StaticResource PtComboBox}" Margin="0,0,0,6" DisplayMemberPath="Name"/>

                            <TextBox x:Name="TxtNewInternal" Grid.Row="0" Grid.Column="4" Height="34" Style="{StaticResource PtTextBox}" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Dahili No" Grid.Row="0" Grid.Column="4" Foreground="{DynamicResource PtTextSecondary}" Margin="10,0,0,6" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtNewInternal}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ComboBox x:Name="CmbNewIssueType" Grid.Row="0" Grid.Column="6" Height="34" Style="{StaticResource PtComboBox}" Margin="0,0,0,6">
                                <ComboBoxItem Content="Yazıcı Sorunu" IsSelected="True"/>
                                <ComboBoxItem Content="Ağ / İnternet"/>
                                <ComboBoxItem Content="Donanım Arızası"/>
                                <ComboBoxItem Content="Yazılım / İşletim Sistemi"/>
                                <ComboBoxItem Content="E-Posta / Hesap"/>
                            </ComboBox>

                            <TextBox x:Name="TxtNewDesc" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Height="34" Style="{StaticResource PtTextBox}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Arıza / Talep açıklaması..." Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource PtTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtNewDesc}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="8" Content="➕ Talep Ekle" Style="{StaticResource PtPrimaryButton}" Width="110" Click="BtnAddTicket_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tickets List -->
                    <ItemsControl x:Name="ListTickets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PersonnelName}" FontWeight="SemiBold" Foreground="{DynamicResource PtTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Department}" Foreground="{DynamicResource PtTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IssueType}" Foreground="{DynamicResource PtTextPrimary}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Description}" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ResolutionNote, StringFormat='💡 Çözüm: {0}'}" FontSize="11" Foreground="#34D399" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasResolutionNote}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="5" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#332200"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Çözüldü">
                                                            <Setter Property="Background" Value="#103318"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Çözüldü">
                                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✓ Çözüldü" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="BtnResolveTicket_Click"/>
                                            <Button Content="🗑️" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="8,3" FontSize="11" Click="BtnDeleteTicket_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. Hardware & Software Inventory Section -->
            <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="🖥️ Cihaz Donanım &amp; Yazılım Zimmet Envanteri" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,0,0,12"/>

                    <!-- Live Machine Hardware & Software Information Card (Bilgi Kutucuğu) -->
                    <Border Background="{DynamicResource PtWindowBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Header & Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource PtAccentGradient}" Width="34" Height="34" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bu Bilgisayarın Donanım &amp; Yazılım Bilgi Kartı" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}"/>
                                            <Border Style="{StaticResource PtBadge}" Margin="8,0,0,0" Padding="6,1">
                                                <TextBlock Text="Canlı Sistem" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtLiveMachineHeader" Text="Cihaz: Algılanıyor... | IP: Algılanıyor..." FontSize="11.5" Foreground="{DynamicResource PtTextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⚡ Bu Bilgisayarı Envantere Kaydet" Style="{StaticResource PtSuccessButton}" Padding="12,6" FontSize="12" Click="BtnAutoRegisterPc_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Specs Summary Grid (Bilgi Kutucuğu Özet Verileri) -->
                            <Border Grid.Row="1" Background="{DynamicResource PtSidebarBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 1: Hardware Summary -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="⚙️ DONANIM BİLEŞENLERİ" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtLiveBrandModel" Text="Model: Algılanıyor..." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PtTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtLiveCpuRam" Text="CPU / RAM: Algılanıyor..." FontSize="11" Foreground="{DynamicResource PtTextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtLiveMotherboard" Text="Anakart: Algılanıyor..." FontSize="10.5" Foreground="{DynamicResource PtTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Col 2: Software & OS Summary -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="🪟 YAZILIM &amp; İŞLETİM SİSTEMİ" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtLiveOsBuild" Text="İşletim Sistemi: Algılanıyor..." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PtTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtLiveSecurity" Text="Güvenlik: Defender Aktif" FontSize="11" Foreground="{DynamicResource PtTextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtLiveBios" Text="BIOS: Algılanıyor..." FontSize="10.5" Foreground="{DynamicResource PtTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Col 3: Network & Assignment -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="🌐 AĞ &amp; KULLANICI BİLGİSİ" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtLiveIpMac" Text="IP / MAC: Algılanıyor..." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PtTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtLiveUser" Text="Kullanıcı: Algılanıyor..." FontSize="11" Foreground="{DynamicResource PtTextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtLiveSerial" Text="Seri No / HWID: Algılanıyor..." FontSize="10.5" FontFamily="Consolas" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Saved Inventory Records List Header -->
                    <TextBlock Text="📋 Kayıtlı Zimmet Envanteri Listesi" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,4,0,6"/>

                    <!-- Empty State Banner -->
                    <Border x:Name="PnlEmptyInventory" Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,2,0,6" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ℹ️ Henüz kayıtlı donanım zimmeti bulunmuyor." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PtTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Yukarıdaki bilgi kutucuğundan 'Bu Bilgisayarı Envantere Kaydet' butonuna tıklayarak ilk donanım zimmet kaydını ekleyebilirsiniz." FontSize="11.5" Foreground="{DynamicResource PtTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="ListInventory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Brand}" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Brand}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Model}" Foreground="{DynamicResource PtTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" Margin="4,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SerialNo, StringFormat='SN: {0}'}" FontFamily="Consolas" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SerialNo}" Margin="4,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontFamily="Consolas" Foreground="{DynamicResource PtTextSecondary}" VerticalAlignment="Center" Margin="4,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding UserName, StringFormat='Zimmet: {0}'}" Foreground="{DynamicResource PtTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding UserName}" Margin="4,0"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🔍 Detay" Tag="{Binding}" Style="{StaticResource PtSecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnShowInventoryDetail_Click"/>
                                            <Button Content="🗑️" Tag="{Binding Id}" Style="{StaticResource PtSecondaryButton}" Padding="8,4" FontSize="11" Click="BtnDeleteInventory_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
