<UserControl x:Class="SysForgeStudio.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Action Buttons (PowerToys Style) -->
        <Border Grid.Row="0" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="💾 Sistem &amp; Yazıcı Ayarları Yedekleme Havuzu" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Kayıt defteri yazdırma yapılandırmasını (HKLM\Print) güvenli bir şekilde yedekleyin ve tek tıkla geri yükleyin." FontSize="12" Foreground="{DynamicResource PtTextSecondary}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="📁 Yedek Klasörü" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
                    <Button Content="💾 Yeni Yedek Al" Style="{StaticResource PtPrimaryButton}" Click="BtnCreateBackup_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Backup DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10" Padding="12">
            <DataGrid x:Name="DgBackups" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{DynamicResource PtSubtleBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1"
                      Foreground="{DynamicResource PtTextPrimary}" RowBackground="{DynamicResource PtCardBg}" AlternatingRowBackground="{DynamicResource PtCardHover}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource PtCardBorder}"
                      HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#333333"/>
                        <Setter Property="Foreground" Value="{DynamicResource PtTextSecondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Yedek Dosyası" Binding="{Binding FileName}" Width="2.5*" />
                    <DataGridTextColumn Header="Oluşturulma Tarihi" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="1.5*" />
                    <DataGridTextColumn Header="Boyut" Binding="{Binding SizeDisplay}" Width="*" />
                    <DataGridTextColumn Header="Tam Yol" Binding="{Binding FullPath}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Style="{StaticResource PtSettingsCard}" Margin="0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚠️ Yedek geri yüklendiğinde Spooler servisi otomatik olarak sıfırlanacaktır." FontSize="12" Foreground="{DynamicResource PtTextSecondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔄 Seçilen Yedeği Geri Yükle" Style="{StaticResource PtSuccessButton}" Click="BtnRestore_Click"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
