<UserControl x:Class="SysForgeStudio.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Action Buttons (PowerToys Style) -->
        <Border Grid.Row="0" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📋 Canlı Olay &amp; İşlem Kayıtları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="Uygulanan tüm onarımların, servis komutlarının ve teşhis adımlarının gerçek zamanlı çıktısı." FontSize="12" Foreground="{DynamicResource PtTextSecondary}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="🌐 HTML Raporu Aç" Style="{StaticResource PtSuccessButton}" Margin="0,0,8,6" Click="BtnHtmlReport_Click"/>
                    <Button Content="📁 Log Klasörü" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,6" Click="BtnOpenLogDir_Click"/>
                    <Button Content="🗑️ Temizle" Style="{StaticResource PtSecondaryButton}" Margin="0,0,8,6" Click="BtnClearLogs_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Terminal Log Box -->
        <Border Grid.Row="1" Style="{StaticResource PtSettingsCard}" Margin="0,0,0,10" Padding="0" Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}">
            <RichTextBox x:Name="RtbLogs" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource PtTextPrimary}"
                         BorderThickness="0" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="16"/>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Style="{StaticResource PtSettingsCard}" Margin="0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtLogStatus" Grid.Column="0" Text="Kayıtlar otomatik olarak günlüğe yazılıyor." FontSize="12" Foreground="{DynamicResource PtTextSecondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="📋 Panoya Kopyala" Style="{StaticResource PtSecondaryButton}" Click="BtnCopyClipboard_Click"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
