<Application x:Class="SysForgeStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SysForgeStudio"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Windows 11 / PowerToys Fluent Dark Palette (Default) -->
        <Color x:Key="PtWindowBgColor">#202020</Color>
        <Color x:Key="PtSidebarBgColor">#181818</Color>
        <Color x:Key="PtCardBgColor">#2B2B2B</Color>
        <Color x:Key="PtCardHoverColor">#323232</Color>
        <Color x:Key="PtCardBorderColor">#383838</Color>
        <Color x:Key="PtAccentColor">#0078D4</Color>
        <Color x:Key="PtAccentHoverColor">#1A86D9</Color>
        <Color x:Key="PtTextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="PtTextSecondaryColor">#A6A6A6</Color>
        <Color x:Key="PtSuccessColor">#107C41</Color>
        <Color x:Key="PtWarningColor">#D83B01</Color>
        <Color x:Key="PtSubtleBgColor">#262626</Color>

        <SolidColorBrush x:Key="PtWindowBg" Color="{StaticResource PtWindowBgColor}" />
        <SolidColorBrush x:Key="PtSidebarBg" Color="{StaticResource PtSidebarBgColor}" />
        <SolidColorBrush x:Key="PtCardBg" Color="{StaticResource PtCardBgColor}" />
        <SolidColorBrush x:Key="PtCardHover" Color="{StaticResource PtCardHoverColor}" />
        <SolidColorBrush x:Key="PtCardBorder" Color="{StaticResource PtCardBorderColor}" />
        <SolidColorBrush x:Key="PtAccent" Color="{StaticResource PtAccentColor}" />
        <SolidColorBrush x:Key="PtAccentHover" Color="{StaticResource PtAccentHoverColor}" />
        <SolidColorBrush x:Key="PtTextPrimary" Color="{StaticResource PtTextPrimaryColor}" />
        <SolidColorBrush x:Key="PtTextSecondary" Color="{StaticResource PtTextSecondaryColor}" />
        <SolidColorBrush x:Key="PtTextMuted" Color="#888888" />
        <SolidColorBrush x:Key="PtSuccess" Color="{StaticResource PtSuccessColor}" />
        <SolidColorBrush x:Key="PtWarning" Color="{StaticResource PtWarningColor}" />
        <SolidColorBrush x:Key="PtDanger" Color="#DC2626" />
        <SolidColorBrush x:Key="PtSubtleBg" Color="{StaticResource PtSubtleBgColor}" />

        <!-- Dynamic Theme Button & Input Brushes -->
        <SolidColorBrush x:Key="PtButtonBg" Color="#2E2E2E" />
        <SolidColorBrush x:Key="PtButtonBorder" Color="#404040" />
        <SolidColorBrush x:Key="PtButtonHover" Color="#3A3A3A" />
        <SolidColorBrush x:Key="PtButtonPressed" Color="#222222" />
        <SolidColorBrush x:Key="PtButtonForeground" Color="#FFFFFF" />

        <SolidColorBrush x:Key="PtNavHover" Color="#2D2D2D" />
        <SolidColorBrush x:Key="PtNavActive" Color="#333333" />

        <SolidColorBrush x:Key="PtInputBg" Color="#262626" />
        <SolidColorBrush x:Key="PtInputBorder" Color="#383838" />
        <SolidColorBrush x:Key="PtBadgeBg" Color="#333333" />

        <SolidColorBrush x:Key="PtGridRow" Color="#2B2B2B" />
        <SolidColorBrush x:Key="PtGridRowAlt" Color="#303030" />
        <SolidColorBrush x:Key="PtGridHeader" Color="#333333" />

        <!-- High-Contrast Status Brushes -->
        <SolidColorBrush x:Key="PtStatusBlue" Color="#38BDF8" />
        <SolidColorBrush x:Key="PtStatusGreen" Color="#4ADE80" />
        <SolidColorBrush x:Key="PtStatusYellow" Color="#FDE047" />
        <SolidColorBrush x:Key="PtStatusAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="PtStatusRed" Color="#F87171" />
        <SolidColorBrush x:Key="PtStatusPurple" Color="#FFA78BFA" />

        <!-- Code & Console Brushes -->
        <SolidColorBrush x:Key="PtCodeBackground" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PtCodeForeground" Color="#38BDF8" />

        <!-- General Color Brushes -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#107C41" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D83B01" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />

        <!-- PowerToys Brand Accent Gradient -->
        <LinearGradientBrush x:Key="PtAccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0078D4" Offset="0.0" />
            <GradientStop Color="#005A9E" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PtSuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#107C41" Offset="0.0" />
            <GradientStop Color="#0B5A2F" Offset="1.0" />
        </LinearGradientBrush>

        <FontFamily x:Key="PtFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

        <!-- PowerToys Navigation Button Style -->
        <Style x:Key="PtNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PtTextSecondary}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="activeIndicator" Width="3" Height="16" HorizontalAlignment="Left" Background="{DynamicResource PtAccent}" CornerRadius="1.5" Visibility="Collapsed" Margin="-8,0,0,0"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PtNavHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PtNavActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PowerToys Settings Card Style (Horizontal layout with icon/title/desc on left, action on right) -->
        <Style x:Key="PtSettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PtCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- PowerToys Primary Button -->
        <Style x:Key="PtPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PtAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PtAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PowerToys Secondary / Subtle Button -->
        <Style x:Key="PtSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PtButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PtButtonForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtButtonBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PtButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PtButtonPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PowerToys Success Button -->
        <Style x:Key="PtSuccessButton" TargetType="Button" BasedOn="{StaticResource PtPrimaryButton}">
            <Setter Property="Background" Value="{StaticResource PtSuccessGradient}" />
        </Style>

        <!-- PowerToys Danger Button -->
        <Style x:Key="PtDangerButton" TargetType="Button" BasedOn="{StaticResource PtPrimaryButton}">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>

        <!-- Modern Toggle Switch CheckBox Style (WinUI / PowerToys Look) -->
        <Style x:Key="PtToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Label / Content on the Left -->
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0" />

                            <!-- Pill Switch on the Right -->
                            <Border x:Name="pillBorder" Grid.Column="1" Width="42" Height="22" CornerRadius="11" Background="{DynamicResource PtButtonBorder}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1">
                                <Ellipse x:Name="thumb" Width="14" Height="14" Fill="{DynamicResource PtTextPrimary}" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="thumbTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource PtAccent}" />
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource PtAccentHover}" />
                                <Setter TargetName="thumb" Property="Fill" Value="White" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PowerToys TextBox -->
        <Style x:Key="PtTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PtInputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource PtAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="tbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource PtAccent}" />
                            </Trigger>
                            <Trigger Property="AcceptsReturn" Value="True">
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource PtTextBox}" />

        <!-- PowerToys Badge Style -->
        <Style x:Key="PtBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PtBadgeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Dynamic Theme ComboBox -->
        <Style x:Key="PtComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PtInputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="comboBorder" Background="{DynamicResource PtInputBg}" BorderBrush="{DynamicResource PtInputBorder}" BorderThickness="1" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="Transparent" />
                                                <Path Grid.Column="1" Data="M 0 0 L 6 6 L 12 0" Stroke="{DynamicResource PtTextSecondary}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="comboBorder" Property="BorderBrush" Value="{DynamicResource PtAccent}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="comboBorder" Property="BorderBrush" Value="{DynamicResource PtAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource PtTextPrimary}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource PtCardBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
                                        <ContentPresenter TextElement.Foreground="{DynamicResource PtTextPrimary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PtCardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PtNavActive}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PtAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PtComboBox}" />

        <!-- Dynamic Theme DataGrid (cells, headers, selection) -->
        <Style x:Key="PtDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PtCardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource PtGridRow}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PtGridRowAlt}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource PtCardBorder}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource PtGridHeader}" />
                        <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PtNavActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PtNavActive}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PtCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PtNavActive}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource PtDataGrid}" />

        <!-- Dynamic Theme ListBox -->
        <Style x:Key="PtListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PtCardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PtCardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PtNavActive}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource PtAccent}" />
                                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource PtListBox}" />

        <!-- Dynamic ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource PtButtonBorder}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PtAccent}" />
        </Style>

        <!-- Default CheckBox text color -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PtTextPrimary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Section label used across views -->
        <Style x:Key="PtSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PtTextMuted}" />
            <Setter Property="Margin" Value="4,8,0,6" />
        </Style>

        <!-- DevToys / PowerToys Setting Card -->
        <Style x:Key="PtSettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PtCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

    </Application.Resources>
</Application>
