<Window x:Class="SysForgeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SysForgeStudio"
        mc:Ignorable="d"
        Title="SysForge Studio - Enterprise IT &amp; Hardware Suite" 
        Height="800" Width="1240"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PtWindowBg}"
        FontFamily="{StaticResource PtFont}"
        Icon="Assets/app_icon.png">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left PowerToys Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource PtSidebarBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand & Search Bar -->
                <StackPanel Grid.Row="0" Margin="16,18,16,12">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="Assets/app_icon.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SysForge Studio" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}" />
                            <TextBlock Text="Enterprise IT &amp; Hardware Suite" FontSize="11" Foreground="{DynamicResource PtTextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Quick Search Box (overlay placeholder — VisualBrush cue breaks dark background) -->
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="TxtSearch" Height="34" VerticalContentAlignment="Center"
                                 Style="{StaticResource PtTextBox}" TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Text="🔍 Modüllerde ara..."
                                   Foreground="{DynamicResource PtTextSecondary}" FontSize="12" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Separator Background="{DynamicResource PtCardBorder}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- PowerToys Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,0">
                        <TextBlock Text="GENEL BAKIŞ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PtTextSecondary}" Margin="18,10,16,4"/>
                        <RadioButton x:Name="NavDashboard" Content="📊  Genel Bakış &amp; Durum" Style="{StaticResource PtNavButtonStyle}" IsChecked="True" Checked="Nav_Checked"/>

                        <TextBlock Text="YAZICI &amp; AĞ YÖNETİMİ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PtTextSecondary}" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavPrinters" Content="🖨️  Yazıcı Bağlantısı &amp; Keşif" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Content="🌐  IP Tarama &amp; Ağ Keşfi (RDP)" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDrivers" Content="🧹  Sürücü Temizliği &amp; Paketler" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="ONARIM &amp; OPTİMİZASYON" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PtTextSecondary}" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavFixes" Content="⚡  Yazıcı &amp; Spooler Hızlı Onarım" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSysRepair" Content="🔧  Windows Çekirdek Onarımı" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDiag" Content="🔍  Sistem Servis &amp; İlke Teşhisi" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Content="🛠️  Windows BT Sistem Araçları" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="GELİŞMİŞ MOTORLAR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PtTextSecondary}" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavModules" Content="🚀  SysForge Entegre Motor Merkezi" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="DONANIM &amp; BT TEKNİK SERVİS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PtTextSecondary}" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavAIDiag" Content="🤖  Yapay Zeka Arıza Teşhis &amp; Onarım" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavExpertise" Content="🛡️  Donanım Ekspertizi &amp; HWID Hash" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavITService" Content="💼  BT Servis Masası &amp; Zimmet" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>

                        <TextBlock Text="GÜNLÜK &amp; YEDEKLEME" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PtTextSecondary}" Margin="18,12,16,4"/>
                        <RadioButton x:Name="NavLogs" Content="📋  Canlı Terminal &amp; Çıktı Günlüğü" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavBackup" Content="💾  Kayıt Defteri &amp; Yapılandırma Yedeği" Style="{StaticResource PtNavButtonStyle}" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource PtSidebarBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SysForge Studio v6.2.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PtTextSecondary}"/>
                            <TextBlock Text="Windows 11 / 10 / Server" FontSize="10" Foreground="{DynamicResource PtTextMuted}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PtBadge}">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PtAccent}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Main Workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Breadcrumb -->
            <Border Grid.Row="0" Background="{DynamicResource PtWindowBg}" BorderBrush="{DynamicResource PtCardBorder}" BorderThickness="0,0,0,1" Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="Genel Bakış &amp; Durum" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PtTextPrimary}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Sistem yazdırma durumu ve hızlı eylemler" FontSize="12" Foreground="{DynamicResource PtTextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Top Right Badges & Progress -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="PbBusy" Width="100" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0" Foreground="{DynamicResource PtAccent}"/>
                        <Button x:Name="BtnThemeToggle" Content="🌙 Koyu tema" Style="{StaticResource PtSecondaryButton}" Margin="0,0,10,0" Padding="10,5" Click="BtnThemeToggle_Click" ToolTip="Şu an Koyu Tema aktif. Açık temaya geçmek için tıklayın."/>
                        <Border Style="{StaticResource PtBadge}" Padding="10,5">
                            <TextBlock Text="🛡️ Yönetici Modu" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PtStatusBlue}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Content -->
            <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
